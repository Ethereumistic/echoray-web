{
	"extends": "@echoray/config/tsconfig/nextjs.json",
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@convex/*": ["./convex/*"],
			"@echoray/ui": ["../../packages/ui/src"],
			"@echoray/ui/components/*": ["../../packages/ui/src/components/*"],
			"@echoray/ui/lib/*": ["../../packages/ui/src/lib/*"],
			"@echoray/database": ["../../packages/database"],
			"@echoray/database/*": ["../../packages/database/*"],
			"@echoray/utils": ["../../packages/utils/src"],
			"@echoray/utils/*": ["../../packages/utils/src/*"]
		},
		"types": [
			"./cloudflare-env.d.ts",
			"node"
		]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
